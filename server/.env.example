# ===== AI 客服后端配置 =====
# 复制本文件为 .env 后按需修改：cp .env.example .env

# 服务端口
PORT=3001

# 模型提供方：ollama（本地离线）| openai（任意 OpenAI 兼容云 API）
PROVIDER=ollama

# ---------------------------------------------------------------
# 方案 A：Ollama 本地模型（默认，免费离线）
#   安装：https://ollama.com  然后执行： ollama pull qwen2.5:7b
# ---------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen2.5:7b
# 使用视觉模型（如 qwen2.5vl:7b）时设为 true，可让 AI 识别上传的图片
SUPPORTS_VISION=false

# ---------------------------------------------------------------
# 方案 B：OpenAI 兼容云 API（PROVIDER=openai 时生效）
#   把下面三项换成对应服务商即可，无需改任何代码：
#
#   DeepSeek:
#     PROVIDER=openai
#     OPENAI_BASE_URL=https://api.deepseek.com/v1
#     OPENAI_MODEL=deepseek-chat
#
#   MiniMax:
#     PROVIDER=openai
#     OPENAI_BASE_URL=https://api.minimaxi.com/v1
#     OPENAI_MODEL=MiniMax-Text-01
#
#   通义千问:
#     PROVIDER=openai
#     OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     OPENAI_MODEL=qwen-plus
#
#   OpenAI:
#     PROVIDER=openai
#     OPENAI_BASE_URL=https://api.openai.com/v1
#     OPENAI_MODEL=gpt-4o-mini
# ---------------------------------------------------------------
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
